# CZ Studio Editor: only source, docs and config go to GitHub.

# dependencies and builds (npm install and the build recreate them)
node_modules/
dist/
build/
out/
.vite/
*.tsbuildinfo
coverage/

# secrets and local settings
.env
.env.*
!.env.example
.claude/settings.local.json

# local test projects and CZ Studio's data folder: footage, proxies and renders never leave the computer
# (keep test projects under /projects; a project's own .cz folder holds undo history, autosave and logs)
/projects/
.cz/
.cz-studio/
*.mp4
*.mov
*.mkv
*.webm
# downloaded transcript models
/models/
*.onnx
*.bin

# logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
